{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Swim site water quality and contamination level", "anchor": "start", "font": "Fraunces", "fontSize": 20, "fontWeight": 600, "color": "#1f2a33", "offset": 14},
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "projection": {
    "type": "mercator",
    "center": [151.1, -33.85],
    "scale": {"expr": "height * 50"},
    "translate": {"expr": "[width / 2.5, height / 2]"}
  },
  "layer": [
    {
      "data": {"url": "data/sydney_outline.json", "format": {"type": "topojson", "feature": "sydney"}},
      "mark": {"type": "geoshape", "clip": true, "fill": "#ece8df", "stroke": "#d2bf93", "strokeWidth": 1}
    },
    {
      "data": {
        "url": "data/nsw_sites_2026.csv",
        "format": {"type": "csv", "parse": {"lat": "number", "lon": "number", "n": "number", "mean_ent": "number", "median_ent": "number", "max_ent": "number"}}
      },
      "params": [
        {"name": "gradeSel", "select": {"type": "point", "fields": ["grade"]}, "bind": "legend"},
        {"name": "sizeSel", "select": {"type": "point", "fields": ["ent_band"]}, "bind": "legend"}
      ],
      "transform": [
        {"filter": "datum.lat > -34.25 && datum.lat < -33.45 && datum.lon > 150.55 && datum.lon < 151.65"},
        {"filter": "datum.n >= 20 && datum.grade !== 'Follow up' && datum.grade !== 'Not graded'"},
        {"calculate": "datum.mean_ent < 10 ? 'Under 10' : datum.mean_ent < 40 ? '10 – 39' : '40 or more'", "as": "ent_band"},
        {"filter": {"param": "gradeSel"}},
        {"filter": {"param": "sizeSel"}}
      ],
      "mark": {"type": "circle", "clip": true, "fillOpacity": 0.5, "stroke": "white", "strokeWidth": 0.4, "strokeOpacity": 0.8},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "order": {"field": "mean_ent", "type": "quantitative", "sort": "descending"},
        "size": {
          "field": "ent_band", "type": "ordinal",
          "scale": {"type": "ordinal", "domain": ["Under 10", "10 – 39", "40 or more"], "range": [70, 200, 480]},
          "legend": {
            "title": ["Average", "enterococci"], "type": "symbol",
            "orient": "none",
            "legendX": {"expr": "width - 100"},
            "legendY": 300,
            "symbolFillColor": "#dbdbdb", "symbolStrokeColor": "#4a5560", "symbolOpacity": 1,
            "labelFontSize": 11, "titleFontSize": 12, "titleFontWeight": 600,
            "titleColor": "#1f2a33", "labelColor": "#4a5560"
          }
        },
        "color": {
          "field": "grade", "type": "nominal",
          "scale": {
            "domain": ["Very Good", "Good", "Fair", "Poor", "Very Poor"],
            "range": ["#14508a", "#7fb0d6", "#f2d58a", "#e0925a", "#a63d14"]
          },
          "legend": {
            "title": ["2026 annual grade"], "type": "symbol",
            "orient": "none",
            "legendX": {"expr": "width - 100"},
            "legendY": 10,
            "symbolType": "circle", "symbolSize": 140, "symbolOpacity": 1,
            "labelFontSize": 11, "titleFontSize": 12, "titleFontWeight": 600,
            "titleColor": "#1f2a33", "labelColor": "#4a5560"
          }
        },
        "tooltip": [
          {"field": "site", "type": "nominal", "title": "Swim site"},
          {"field": "grade", "type": "nominal", "title": "2026 annual grade"},
          {"field": "mean_ent", "type": "quantitative", "title": "Average enterococci", "format": ".1f"},
          {"field": "median_ent", "type": "quantitative", "title": "Median enterococci", "format": ".1f"},
          {"field": "max_ent", "type": "quantitative", "title": "Highest sample", "format": ".0f"},
          {"field": "n", "type": "quantitative", "title": "Samples"},
          {"field": "region", "type": "nominal", "title": "Region"}
        ]
      }
    },
    {
      "data": {
        "url": "data/nsw_sites_2026.csv",
        "format": {"type": "csv", "parse": {"lat": "number", "lon": "number", "n": "number", "mean_ent": "number"}}
      },
      "transform": [
        {"filter": "datum.lat > -34.25 && datum.lat < -33.45 && datum.lon > 150.55 && datum.lon < 151.65"},
        {"filter": "datum.n >= 20 && datum.grade !== 'Follow up' && datum.grade !== 'Not graded'"},
        {"joinaggregate": [{"op": "count", "as": "total"}]},
        {"calculate": "datum.mean_ent < 10 ? 'Under 10' : datum.mean_ent < 40 ? '10 – 39' : '40 or more'", "as": "ent_band"},
        {"filter": {"param": "gradeSel"}},
        {"filter": {"param": "sizeSel"}},
        {"aggregate": [{"op": "count", "as": "shown"}, {"op": "max", "field": "total", "as": "total"}]},
        {"calculate": "'Showing ' + datum.shown + ' of ' + datum.total + ' sites'", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "bottom", "dx": 8, "dy": -380, "fontSize": 13, "fontWeight": 700, "color": "#1f2a33"},
      "encoding": {"x": {"value": 0}, "y": {"value": "height"}, "text": {"field": "label"}}
    },
{
  "data": {"values": [{"k": 1}]},
  "mark": {"type": "circle", "size": 8825, "fill": null, "stroke": "#4a5560", "strokeWidth": 1.2, "strokeDash": [4, 3]},
  "encoding": {"x": {"value": 226}, "y": {"value": 271}}
},
{
  "data": {"values": [
    {"x": 12, "y": 239.5, "text": "Highest bacteria cluster", "color": "#1f2a33"},
    {"x": 12, "y": 254.5, "text": "around the cities, several", "color": "#1f2a33"},
    {"x": 12, "y": 269.5, "text": "with", "color": "#1f2a33"},
    {"x": 39, "y": 269.5, "text": "Poor", "color": "#b5541b"},
    {"x": 70, "y": 269.5, "text": "or", "color": "#1f2a33"},
    {"x": 86, "y": 269.5, "text": "Very Poor", "color": "#a63d14"},
    {"x": 12, "y": 284.5, "text": "water quality", "color": "#1f2a33"},
    {"x": 320, "y": 160, "text": "Almost 75% of sites have", "color": "#1f2a33"},
    {"x": 320, "y": 175, "text": "Good", "color": "#3a78b0"},
    {"x": 355, "y": 175, "text": "or", "color": "#1f2a33"},
    {"x": 370, "y": 175, "text": "Very Good", "color": "#14508a"},
    {"x": 320, "y": 190, "text": "water quality, yet almost", "color": "#1f2a33"},
    {"x": 320, "y": 205, "text": "50% of sites have high", "color": "#1f2a33"},
    {"x": 320, "y": 220, "text": "levels of bacteria", "color": "#1f2a33"}
  ]},
  "mark": {"type": "text", "align": "left", "baseline": "middle", "fontSize": 12, "fontStyle": "italic", "fontWeight": 600},
  "encoding": {
    "x": {"field": "x", "type": "quantitative", "scale": null, "axis": null},
    "y": {"field": "y", "type": "quantitative", "scale": null, "axis": null},
    "text": {"field": "text"},
    "color": {"field": "color", "type": "nominal", "scale": null, "legend": null}
    }
  }
    ],
    "config": {"view": {"stroke": null}}
}