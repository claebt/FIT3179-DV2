{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Distribution of facilities at beaches", "anchor": "start", "font": "Fraunces", "fontSize": 20, "fontWeight": 600, "color": "#1f2a33", "offset": 14},
  "width": "container",
  "height": 460,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "data": {"url": "data/vic_beach_facilities.csv", "format": {"type": "csv", "parse": {"N_FACILITIES": "number"}}},
  "transform": [
    {"calculate": "datum.N_FACILITIES == 0 ? 'None' : datum.N_FACILITIES <= 3 ? '1–3' : datum.N_FACILITIES <= 6 ? '4–6' : datum.N_FACILITIES <= 9 ? '7–9' : '10–13'", "as": "band"},
    {"aggregate": [{"op": "count", "as": "n"}], "groupby": ["band"]},
    {"joinaggregate": [{"op": "sum", "field": "n", "as": "total"}]},
    {"calculate": "round(100 * datum.n / datum.total)", "as": "pct"},
    {"calculate": "format(datum.n, ',') + ' beaches'", "as": "label"},
    {"calculate": "datum.pct + '% of Victoria\\'s ' + datum.total + '|beaches have none'", "as": "pct_text"},
    {"calculate": "0", "as": "zero"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 3, "strokeCap": "round"},
      "encoding": {
        "y": {
          "field": "band", "type": "nominal", "sort": ["None", "1–3", "4–6", "7–9", "10–13"], "scale": {"paddingInner": 0.5},
          "title": "Facilities at the beach (of 13)",
          "axis": {"labelFontSize": 12, "titleFontSize": 12, "titleColor": "#1f2a33", "domain": false, "ticks": false, "labelPadding": 8, "titlePadding": 8}
        },
        "x": {
          "field": "zero", "type": "quantitative", "scale": {"domain": [0, 760]}, "title": "Number of beaches",
          "axis": {"values": [0, 100, 200, 300, 400, 500, 600, 700], "labelFontSize": 11, "titleFontSize": 12, "titleColor": "#1f2a33", "gridColor": "#eef2f4", "domain": false, "ticks": false, "titlePadding": 12}
        },
        "x2": {"field": "n"},
        "color": {
          "field": "band", "type": "nominal",
          "scale": {"domain": ["None", "1–3", "4–6", "7–9", "10–13"], "range": ["#d6d0c2", "#dcb459", "#c48a30", "#8c5c14", "#553507"]},
          "legend": null
        }
      }
    },
    {
      "mark": {"type": "circle", "size": 420, "opacity": 1},
      "encoding": {
        "y": {"field": "band", "type": "nominal", "sort": ["None", "1–3", "4–6", "7–9", "10–13"], "scale": {"paddingInner": 0.5}},
        "x": {"field": "n", "type": "quantitative", "scale": {"domain": [0, 760]}},
        "color": {
          "field": "band", "type": "nominal",
          "scale": {"domain": ["None", "1–3", "4–6", "7–9", "10–13"], "range": ["#d6d0c2", "#dcb459", "#c48a30", "#8c5c14", "#553507"]},
          "legend": null
        },
        "tooltip": [
          {"field": "band", "title": "Facilities"},
          {"field": "n", "type": "quantitative", "title": "Beaches"},
          {"field": "pct", "type": "quantitative", "title": "% of all beaches"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.band === 'None'"}],
      "mark": {"type": "text", "align": "center", "baseline": "top", "dy": 30, "lineBreak": "|", "lineHeight": 17, "fontSize": 12, "fontWeight": 700, "fontStyle": "italic", "color": "#1f2a33"},
      "encoding": {
        "y": {"field": "band", "type": "nominal", "sort": ["None", "1–3", "4–6", "7–9", "10–13"], "scale": {"paddingInner": 0.5}},
        "x": {"field": "n", "type": "quantitative", "scale": {"domain": [0, 760]}},
        "text": {"field": "pct_text"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}