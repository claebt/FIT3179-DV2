{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "data": {
    "url": "data/vic_beach_facilities.csv",
    "format": {"type": "csv", "parse": {"N_FACILITIES": "number"}}
  },
  "transform": [
    {"calculate": "datum.N_FACILITIES == 0 ? 'None' : datum.N_FACILITIES <= 3 ? '1-3' : datum.N_FACILITIES <= 6 ? '4-6' : datum.N_FACILITIES <= 9 ? '7-9' : '10-13'", "as": "band"},
    {"aggregate": [{"op": "count", "as": "n"}], "groupby": ["band"]},
    {"joinaggregate": [{"op": "sum", "field": "n", "as": "total"}]},
    {"calculate": "round(100 * datum.n / datum.total)", "as": "pct"},
    {"calculate": "format(datum.n, ',') + ' beaches · ' + datum.pct + '%'", "as": "label"}
  ],
  "encoding": {
    "y": {
      "field": "band", "type": "nominal",
      "title": "Facilities at the beach (of 13)",
      "sort": ["None", "1-3", "4-6", "7-9", "10-13"],
      "scale": {"paddingInner": 0.35, "paddingOuter": 0.1},
      "axis": {"labelFontSize": 12, "titleFontSize": 12, "titleColor": "#1f2a33", "domain": false, "ticks": false}
    },
    "x": {
      "field": "n", "type": "quantitative",
      "title": "Number of beaches",
      "scale": {"domain": [0, 760]},
      "axis": {"values": [0, 100, 200, 300, 400, 500, 600, 700], "labelFontSize": 11, "titleFontSize": 12,
               "titleColor": "#1f2a33", "gridColor": "#eef2f4", "domain": false, "ticks": false}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 4},
      "encoding": {
        "color": {
          "field": "band", "type": "nominal",
          "scale": {"domain": ["None", "1-3", "4-6", "7-9", "10-13"],
                    "range": ["#cfd8de", "#b9d3e8", "#7fb0d6", "#3f85bd", "#14508a"]},
          "legend": null
        },
        "tooltip": [
          {"field": "band", "title": "Facilities"},
          {"field": "n", "type": "quantitative", "title": "Beaches"},
          {"field": "pct", "type": "quantitative", "title": "% of all beaches"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 12, "fontWeight": 600, "color": "#1f2a33"},
      "encoding": {"text": {"field": "label"}}
    }
  ],
  "config": {"view": {"stroke": null}}
}